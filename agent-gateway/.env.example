# Agent Gateway configuration. Copy to .env (git-ignored) and fill in at least one provider.

# --- Providers (keys never reach the browser) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint: vLLM, llama.cpp, Ollama, LM Studio
# LOCAL_LLM_BASE_URL=http://vllm:8000/v1
# LOCAL_LLM_MODEL=qwen3-instruct
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_VISION=1          # the local model accepts images

# --- Models ---
AGENT_DEFAULT_PROVIDER=anthropic
AGENT_DEFAULT_MODEL=claude-haiku-5-5
# Extra models users may pick in the panel: <provider>:<model>, comma-separated
# AGENT_MODELS=anthropic:claude-sonnet-5-5,local:qwen3-instruct
AGENT_EFFORT=medium           # Anthropic effort: low | medium | high | xhigh | max

# --- Identity in commits and presence: "<user> (via <label>)" ---
AGENT_LABEL=Paper Assistant
AGENT_ID=paper-assistant-v1

# --- Limits ---
# AGENT_MAX_ITERATIONS=12
# AGENT_RUN_TIMEOUT_MS=300000
# AGENT_TOOL_TIMEOUT_MS=90000
# AGENT_MAX_OUTPUT_TOKENS=32000
# AGENT_MAX_COMPILES_PER_RUN=3

# --- Aldine without accounts (AUTH_ENABLED off): the operator MCP token ---
# ALDINE_MCP_TOKEN=
